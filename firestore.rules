rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to verify verified studio administrative privileges
    function isAdmin() {
      return request.auth != null && (
        request.auth.token.admin == true ||
        request.auth.token.email.matches('.*@appvertex\\.in') ||
        request.auth.token.email == 'appvertex.in@gmail.com'
      );
    }

    // Testimonials collection: public read, administrator schema-validated write
    match /testimonials/{testimonialId} {
      allow read: if true;
      allow delete: if isAdmin();
      allow create, update: if isAdmin()
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 100
        && request.resource.data.text is string
        && request.resource.data.text.size() <= 1000;
    }
    
    // Projects collection: public read, administrator schema-validated write
    match /projects/{projectId} {
      allow read: if true;
      allow delete: if isAdmin();
      allow create, update: if isAdmin()
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 150;
    }
    
    // Inquiries collection: public intake for client proposals with payload limits, admin read/update/delete
    match /inquiries/{inquiryId} {
      allow create: if request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 100
        && request.resource.data.email is string
        && request.resource.data.email.size() > 3
        && request.resource.data.email.size() <= 150;
      allow read, update, delete: if isAdmin();
    }

    // Applications collection: public intake for upskill mentorship with payload limits, admin read/update/delete
    match /applications/{applicationId} {
      allow create: if request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 100
        && request.resource.data.email is string
        && request.resource.data.email.size() > 3
        && request.resource.data.email.size() <= 150;
      allow read, update, delete: if isAdmin();
    }

    // Settings collection: public read, administrator write
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
